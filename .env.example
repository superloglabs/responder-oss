# The local scripts fill these with workspace-specific values. Deployments
# should inject a separate database URL through their secret environment.
COMPOSE_PROJECT_NAME=responder-local
RESPONDER_WORKSPACE_PATH=
RESPONDER_WORKSPACE_SLUG=local
RESPONDER_PORTLESS_NAME=responder.local
RESPONDER_LOCAL_TLD=local
CONTROL_PLANE_WEB_PORT=3000
CONTROL_PLANE_API_PORT=3001
LOCAL_DATABASE_PORT=3003
DATABASE_URL=postgresql://responder:responder@127.0.0.1:3003/responder
DATABASE_POOL_SIZE=5

# Local dashboard URL used in Slack issue actions. local:dev replaces this with
# the stable Portless worktree URL.
RESPONDER_APP_URL=http://localhost:3000
# Optional stable HTTPS origin for integration callbacks and webhooks.
RESPONDER_PUBLIC_URL=
# Optional static ngrok origin. When set, local:dev starts one shared ngrok
# relay to the callback router and uses this as RESPONDER_PUBLIC_URL. Run
# `pnpm tunnel:claim` to route it to the current healthy worktree.
RESPONDER_NGROK_URL=

# Public dashboard URL used in notifications sent by the worker.
CONTROL_PLANE_URL=http://localhost:3000

# The worker runs investigations in a Daytona sandbox with the OpenAI agent
# runtime, and the control plane stores workspace secrets in Daytona's
# write-only vault. DAYTONA_API_KEY is required for either feature;
# OPENAI_API_KEY is required for investigations. OPENAI_AGENT_MODEL overrides
# the default gpt-5.6-sol, and the DAYTONA_* URL/target are optional.
OPENAI_API_KEY=
DAYTONA_API_KEY=
OPENAI_AGENT_MODEL=
DAYTONA_API_URL=
DAYTONA_TARGET=

# Shared bearer token for internal application requests.
INTERNAL_INGEST_TOKEN=

# Base64-encoded 32-byte key for customer credentials. Configure the same value
# for both the control-plane and worker processes.
CREDENTIAL_ENCRYPTION_KEY=

# Autumn meters monthly investigation usage for each organization. Configure
# this for both the control-plane and worker processes.
BILLING_ENABLED=false
AUTUMN_SECRET_KEY=

# Better Auth uses the same Postgres database as the application.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated login emails that receive platform-wide user support access.
SUPERUSER_EMAILS=

# OAuth apps used for account login. Their callbacks are:
# /api/auth/callback/google and /api/auth/callback/github.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Workspace invitation email. In development, invitations are still created
# when RESEND_API_KEY is omitted and their secure links remain copyable.
RESEND_API_KEY=
RESPONDER_FROM_EMAIL=Responder <no-reply@superlog.sh>
RESPONDER_REPLY_TO_EMAIL=

# Product analytics. Use the same PostHog project token in both processes.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
# Vite exposes these public values to the browser bundle.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# X Ads signup conversion tracking, sent server side through the Conversion
# API. OAuth 1.0a credentials come from a developer app attached to the X Ads
# account; the event id is the full identifier from X Events Manager, e.g.
# tw-example-signup. Leave empty to disable.
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=
X_ADS_SIGNUP_EVENT_ID=
# The browser pixel is disabled when the public event id is empty.
VITE_X_ADS_SIGNUP_EVENT_ID=

# Error monitoring for Responder itself. The server DSN covers the API and
# worker; the VITE-prefixed DSN covers browser errors. They may point to the
# same Sentry project. Error monitoring is disabled when omitted.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
# Performance tracing is opt-in. Values must be between 0 and 1.
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_TRACES_SAMPLE_RATE=0
# Production browser builds upload private source maps when all three build-only
# values are configured. Never expose the auth token through a VITE-prefixed key.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# First-party integration application credentials.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SENTRY_APP_SLUG=
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
DATADOG_WEBHOOK_SECRET=
